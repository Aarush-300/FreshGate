# Optional fallback credentials for API clients that do not send request-scoped keys.
# Dashboard users enter their own keys for each live verification request.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Server & Gateway Security Configuration
PORT=8000
BIFROST_UPSTREAM_URL=http://localhost:8080
# Optional first-admin bootstrap token for the Bifrost Docker service.
BIFROST_SETUP_TOKEN=
FRESHGATE_API_KEY=optional_client_api_key_here
FRESHGATE_ADMIN_KEY=your_admin_secret_token_here
FRESHGATE_RATE_LIMIT_PER_MINUTE=60
FRESHGATE_MAX_BODY_SIZE_BYTES=1048576
# Granular Gateway Timeouts (seconds)
FRESHGATE_UPSTREAM_TIMEOUT=60.0
FRESHGATE_EXTRACTION_TIMEOUT=4.0
FRESHGATE_SEARCH_TIMEOUT=5.0
FRESHGATE_JUDGING_TIMEOUT=5.0
FRESHGATE_TIMEOUT=8.0
FRESHGATE_FAIL_OPEN=true
FRESHGATE_ASYNC_MODE=false

# Cache (optional Redis)
REDIS_URL=redis://localhost:6379/0

# Durable SQLite data for policies, monitored claims, immutable verification history, and alerts.
# Mount a persistent volume at this path in production deployments.
FRESHGATE_FEATURE_DB=freshgate_features.db
# Scheduled Watchtower checks require these server-side provider credentials.
# Keys entered for direct dashboard verification are never stored or reused.
FRESHGATE_WATCHTOWER_ENABLED=true
FRESHGATE_WATCHTOWER_POLL_SECONDS=10
FRESHGATE_WATCHTOWER_MAX_CONCURRENCY=2
FRESHGATE_WATCHTOWER_MAX_CLAIMS=1000
FRESHGATE_WATCHTOWER_LEASE_SECONDS=900
FRESHGATE_WATCHTOWER_MAX_RETRIES=3
FRESHGATE_WATCHTOWER_RETRY_BASE_SECONDS=60
