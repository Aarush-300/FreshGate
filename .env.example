# Server-level keys are used by the gateway proxy and native plugin verification endpoint. Dashboard users always use the keys saved in their own Profile.
TAVILY_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Environment & Cookies
# Set to "production" on Render
FRESHGATE_ENV=development
# Set to "true" on Render (HTTPS)
COOKIE_SECURE=false

# Server & Gateway Security Configuration
PORT=8000
BIFROST_UPSTREAM_URL=http://localhost:8080
# Optional first-admin bootstrap token for the Bifrost Docker service.
BIFROST_SETUP_TOKEN=
# Optional client API key (required in production)
FRESHGATE_API_KEY=
# Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
FRESHGATE_ADMIN_KEY=
# Optional for local development (a stable ignored secret file is generated if unset).
# Required in production. Generate with: python -c "import secrets;print(secrets.token_urlsafe(32))"
FRESHGATE_SESSION_SECRET=
MONGODB_URI=mongodb://localhost:27017
MONGODB_DATABASE=freshgate
# Local single-user installs can use SQLite; set FRESHGATE_STORE=mongo and MONGODB_URI for multi-user deployments.
# FRESHGATE_STORE defaults to MongoDB in production when this setting is omitted.
FRESHGATE_STORE=sqlite
# Keep the single-user SQLite database in the project data directory.
FRESHGATE_USERS_DB=freshgate_features.db
# Set FRESHGATE_USERS_STORE=mongo to retain Mongo-backed accounts while using SQLite features.
FRESHGATE_RATE_LIMIT_PER_MINUTE=60
FRESHGATE_MAX_BODY_SIZE_BYTES=1048576
# File upload route independently allows up to 10 MB plus multipart overhead.
FRESHGATE_MAX_UPLOAD_SIZE_BYTES=10485760
FRESHGATE_ALLOWED_UPLOAD_TYPES=.pdf,.txt,.md,.json,.docx,.csv

# Granular Gateway Timeouts (seconds)
FRESHGATE_UPSTREAM_TIMEOUT=60.0
FRESHGATE_EXTRACTION_TIMEOUT=4.0
FRESHGATE_SEARCH_TIMEOUT=5.0
FRESHGATE_JUDGING_TIMEOUT=5.0
FRESHGATE_TIMEOUT=8.0
FRESHGATE_FAIL_OPEN=true
FRESHGATE_ASYNC_MODE=false

# Cache (optional Redis)
REDIS_URL=

# SQLite paths (cache, audit log, and fallback feature store)
FRESHGATE_CACHE_DB=freshgate_cache.db
FRESHGATE_AUDIT_DB=freshgate_audit.db
FRESHGATE_FEATURE_DB=freshgate_features.db
FRESHGATE_WATCHTOWER_ENABLED=true
FRESHGATE_WATCHTOWER_POLL_SECONDS=10
FRESHGATE_WATCHTOWER_MAX_CONCURRENCY=2
FRESHGATE_WATCHTOWER_MAX_CLAIMS=50
FRESHGATE_WATCHTOWER_LEASE_SECONDS=900
FRESHGATE_WATCHTOWER_MAX_RETRIES=3
FRESHGATE_WATCHTOWER_RETRY_BASE_SECONDS=60

# Email delivery (HTTPS APIs work on all clouds including Render Free; SMTP is blocked on Render Free)
# Option A: Brevo API (Recommended on Render Free: 300 free emails/day, NO custom domain needed - verify your Gmail at https://brevo.com)
BREVO_API_KEY=
# Option B: Resend API (3,000 free emails/mo via HTTPS port 443 at https://resend.com)
RESEND_API_KEY=
SENDGRID_API_KEY=

# Option B: SMTP for Watchtower email reports (587 = STARTTLS, 465 = implicit TLS; blocked on Render Free, works on paid or local)
FRESHGATE_SMTP_HOST=
FRESHGATE_SMTP_PORT=587
FRESHGATE_SMTP_USER=
FRESHGATE_SMTP_PASSWORD=
FRESHGATE_SMTP_FROM=
FRESHGATE_SMTP_TLS=true
FRESHGATE_ADMIN_EMAIL=
